            "minimum": 0,
            "title": "Saturação mínima",
            "type": "integer",
            "x-group": "measure",
            "x-level": 1
          },
          "s_max": {
            "default": 255,
            "description": "0 a 255",
            "maximum": 255,
            "minimum": 0,
            "title": "Saturação máxima",
            "type": "integer",
            "x-group": "measure",
            "x-level": 2
          },
          "v_min": {
            "default": 0,
            "description": "0 a 255",
            "maximum": 255,
            "minimum": 0,
            "title": "Brilho mínimo",
            "type": "integer",
            "x-group": "measure",
            "x-level": 1
          },
          "v_max": {
            "default": 255,
            "description": "0 a 255",
            "maximum": 255,
            "minimum": 0,
