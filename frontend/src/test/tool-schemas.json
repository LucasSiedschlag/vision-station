        "x-level": 1,
        "x-widget": "region"
      }
    },
    "required": ["rect"],
    "title": "FixedParams",
    "type": "object"
  },
  "template": {
    "additionalProperties": false,
    "description": "Acha na imagem uma foto ensinada do objeto (ou de uma marca nele).",
