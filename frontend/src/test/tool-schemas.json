      "work_width": {
        "default": 640,
        "maximum": 4096,
        "minimum": 64,
        "title": "Largura de trabalho (px)",
        "type": "integer",
        "x-group": "measure",
        "x-level": 3,
        "x-unit": "px"
      }
    },
    "required": ["mode"],
    "title": "BlobParams",
    "type": "object"
  },
  "fixed": {
    "additionalProperties": false,
    "description": "O objeto fica sempre no mesmo lugar: a âncora é um retângulo escrito no job.",
