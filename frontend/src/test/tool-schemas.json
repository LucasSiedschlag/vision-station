                  { "maximum": 255, "minimum": 0, "type": "integer" },
                  { "maximum": 255, "minimum": 0, "type": "integer" }
                ],
                "type": "array"
              },
              { "type": "null" }
            ],
            "default": null,
            "description": "0 a 255 cada",
            "title": "Cor de referência (R, G, B)",
            "x-group": "measure",
            "x-level": 1,
            "x-widget": "reference-color"
          },
          "max_distance": {
            "default": 20.0,
            "description": "Quanto a cor pode diferir da referência; 10 a 30 é comum",
            "exclusiveMinimum": 0,
            "maximum": 200,
            "title": "Distância máxima (ΔE)",
            "type": "number",
            "x-group": "measure",
            "x-level": 1,
            "x-unit": "ΔE"
          }
        },
        "title": "ColorRange",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "O objeto é a maior região de uma cor, ou mais escura ou mais clara que o fundo.",
    "properties": {
      "mode": {
        "enum": ["color", "dark", "light"],
        "title": "O objeto é",
        "type": "string",
        "x-enum-labels": {
          "color": "de uma cor",
          "dark": "mais escuro que o fundo",
          "light": "mais claro que o fundo"
        },
        "x-group": "measure",
        "x-level": 1
      },
      "color": {
        "anyOf": [{ "$ref": "#/$defs/ColorRange" }, { "type": "null" }],
