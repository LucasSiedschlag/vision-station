[
  {
    "name": "initial JavaScript (the operator screen)",
    "path": "dist/assets/index-*.js",
    "limit": "150 kB",
    "gzip": true
  },
  {
    "name": "all JavaScript of the product screens, including those loaded on demand",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/DesignPage-*.js"
    ],
    "limit": "500 kB",
    "gzip": true
  },
  {
    "name": "the /design gallery (development reference, loaded only at /design)",
    "path": "dist/assets/DesignPage-*.js",
    "limit": "170 kB",
    "gzip": true
  },
  {
    "name": "styles",
    "path": "dist/assets/*.css",
    "limit": "40 kB",
    "gzip": true
  }
]